# Backend GraphQL API URL
VITE_API_URL="http://localhost:4000/"

# Firebase web app config (Firebase Console > Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
# Optional. Defaults to <project-id>.firebasestorage.app; older projects use <project-id>.appspot.com
# (Firebase Console > Storage shows the bucket name, e.g. gs://trackfit-123.firebasestorage.app).
VITE_FIREBASE_STORAGE_BUCKET=""

# Mirrors the backend's DEV_AUTH_BYPASS — set both to the same value.
# Creates throwaway dev users instead of real Firebase sign-ins (Google, email/password).
# NEVER set this in production.
VITE_DEV_AUTH_BYPASS="true"
