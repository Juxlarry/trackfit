# Backend GraphQL API URL
VITE_API_URL="http://localhost:4000/"

# Firebase web app config (Firebase Console > Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Mirrors the backend's DEV_AUTH_BYPASS — set both to the same value.
# Shows a "dev sign-in" shortcut instead of the real Firebase phone-auth flow.
# NEVER set this in production.
VITE_DEV_AUTH_BYPASS="true"
