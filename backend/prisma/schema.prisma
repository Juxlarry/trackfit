// TrackFit backend — Prisma schema
// MVP 1: Identity + Tracking. MVP 2 (sql/002_mvp2.sql) adds intake + screening
// (Identity), generated programs + activities (Tracking) and the first Nutrition
// tables. Goals/Social/Notifications are added when their phase starts.
//
// Modules are kept in separate Postgres schemas (the "separate schema per module"
// guardrail from architecture.md §3) so an accidental cross-module join requires
// an explicit cross-schema reference.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "tracking", "nutrition", "notifications"]
}

// ─────────────────────────────────────────────────────────────────────────
// Identity module
// ─────────────────────────────────────────────────────────────────────────

enum UnitsPreference {
  METRIC
  IMPERIAL

  @@schema("identity")
}

model User {
  id          String   @id @default(uuid())
  /// Firebase Auth UID — the external identity this user maps to.
  firebaseUid String   @unique
  displayName String
  phoneNumber String?  @unique
  email       String?  @unique
  units       UnitsPreference @default(METRIC)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  onboardedAt DateTime?
  /// IANA time zone from the browser, e.g. "Africa/Accra". Reminder times are local to it.
  timeZone    String?

  weightEntries    WeightEntry[]
  healthScreening  HealthScreening?
  intakeProfile    IntakeProfile?
  dietaryProfile   DietaryProfile?
  programs         GeneratedProgram[]
  pushSubscriptions PushSubscription[]
  reminderLog      ReminderLog[]
  reminderPrefs    ReminderPrefs?
  progressPhotos   ProgressPhoto[]
  nutritionPlans   NutritionPlan[]
  mealEntries      MealEntry[]
  customFoods      CustomFood[]
  foodLogs         FoodLog[]
  waterDays        WaterDay[]
  activityLogs     ActivityLog[]
  workoutTemplates WorkoutTemplate[]
  workoutSessions  WorkoutSession[]
  customExercises  Exercise[]

  @@schema("identity")
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────
// Tracking module (weight + workouts — see architecture.md §3 for why
// these two live in one module rather than being split)
// ─────────────────────────────────────────────────────────────────────────

model WeightEntry {
  id              String   @id @default(uuid())
  userId          String
  recordedAt      DateTime @default(now())
  weightKg        Float
  bodyFatPercent  Float?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@schema("tracking")
  @@map("weight_entries")
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  GLUTES
  CORE
  FULL_BODY
  CARDIO
  OTHER

  @@schema("tracking")
}

model Exercise {
  id           String      @id @default(uuid())
  name         String
  muscleGroup  MuscleGroup
  equipment    String?
  isCustom     Boolean     @default(false)
  ownerId      String?
  /// Movement pattern used for form illustrations and load suggestions (MVP 2).
  pattern      String?
  createdAt    DateTime    @default(now())

  owner      User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  setLogs    SetLog[]
  templateItems WorkoutTemplateExercise[]

  @@index([name])
  @@schema("tracking")
  @@map("exercises")
}

model WorkoutTemplate {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  /// MVP 2: generated programs reuse this model (spec §4.3 note).
  isGenerated Boolean  @default(false)
  programId   String?
  weekday     Int?     @db.SmallInt
  sessionType String?
  isActive    Boolean  @default(true)
  warmup      Json     @default("[]")

  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   GeneratedProgram?           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises WorkoutTemplateExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
  @@schema("tracking")
  @@map("workout_templates")
}

/// Join table: which exercises belong to a template, in what order, with target sets/reps.
model WorkoutTemplateExercise {
  id               String  @id @default(uuid())
  templateId       String
  exerciseId       String
  order            Int
  targetSets       Int
  targetReps       Int
  repRange         String?
  /// Exercise this one replaced because of an injury (MVP 2).
  replaces         String?

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([templateId, order])
  @@schema("tracking")
  @@map("workout_template_exercises")
}

model WorkoutSession {
  id              String    @id @default(uuid())
  userId          String
  templateId      String?
  startedAt       DateTime  @default(now())
  durationMinutes Int?
  notes           String?
  /// Opt-in per-session club sharing (spec §4.7). Always false for MVP1 — no
  /// Social module yet — kept on the model now so Phase 3 doesn't need a migration
  /// that touches already-logged sessions.
  shareToClubs    Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sets      SetLog[]
  milestones Milestone[]

  @@index([userId, startedAt])
  @@schema("tracking")
  @@map("workout_sessions")
}

model SetLog {
  id         String  @id @default(uuid())
  sessionId  String
  exerciseId String
  setNumber  Int
  reps       Int
  weightKg   Float
  rpe        Float?
  notes      String?

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([exerciseId])
  @@schema("tracking")
  @@map("set_logs")
}

enum MilestoneType {
  HEAVIEST_SET
  ESTIMATED_1RM
  MOST_REPS_AT_WEIGHT

  @@schema("tracking")
}

/// Personal records, auto-detected right after a session is logged (spec §4.2).
model Milestone {
  id          String        @id @default(uuid())
  sessionId   String
  exerciseId  String
  type        MilestoneType
  value       Float
  achievedAt  DateTime      @default(now())

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@schema("tracking")
  @@map("milestones")
}

// ─────────────────────────────────────────────────────────────────────────
// MVP 2: guided onboarding + generated plans (spec §4.8, sql/002_mvp2.sql)
// Enumerated text columns are CHECK-constrained in SQL; see the engine types
// in src/modules/planning/engine/types.ts for the allowed values.
// ─────────────────────────────────────────────────────────────────────────

/// Only the boolean gate flags, never free-text medical detail (spec §6).
model HealthScreening {
  userId                String   @id
  heartCondition        Boolean
  highBloodPressure     Boolean
  diabetes              Boolean
  pregnant              Boolean
  recentSurgeryOrInjury Boolean
  chestPainOrDizziness  Boolean
  under18               Boolean
  screenedOut           Boolean
  screenedAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("identity")
  @@map("health_screenings")
}

model IntakeProfile {
  userId          String   @id
  sex             String
  age             Int      @db.SmallInt
  heightCm        Float
  weightKg        Float
  bodyFatLevel    Int?     @db.SmallInt
  goalType        String
  targetWeightKg  Float?
  goalPace        String?
  motivations     String[]
  experience      String
  liftComfort     String
  equipment       String
  availableDays   Int[]    @db.SmallInt
  daysPerWeek     Int      @db.SmallInt
  sessionMinutes  Int      @db.SmallInt
  splitPreference String
  fullBodyDay     Boolean  @default(false)
  priorityMuscles String[]
  /// Muscles not to prioritise (kept at maintenance volume).
  lowPriorityMuscles String[]
  injuries        String[]
  injuryNote      String?
  cardioFrequency String?
  cardioLikes     String[]
  activityLevel   String
  sleepHours      Float
  sleepQuality    String?
  trainTime       String?
  busyness        String?
  warmup          Boolean  @default(true)
  energy          String?
  blockers        String[]
  mindset         Json     @default("{}")
  reminderTime    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("identity")
  @@map("intake_profiles")
}

model GeneratedProgram {
  id             String   @id @default(uuid())
  userId         String
  cycleNumber    Int      @default(1)
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  status         String   @default("ACTIVE")
  /// The ±1 training-day rule is anchored to this value.
  onboardingDays Int      @db.SmallInt
  daysPerWeek    Int      @db.SmallInt
  splitLabel     String
  /// Set by the week-6 check-in: accessory rotation and set changes (engine BuildOptions).
  buildOptions   Json     @default("{}")
  /// Starting weight per exercise name, from weeks 5-6 of the previous cycle.
  startLoads     Json     @default("{}")
  /// Running calorie correction from real results.
  kcalOffset     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates WorkoutTemplate[]
  swaps     ScheduleSwap[]
  checkin   CycleCheckin?     @relation("CheckinOf")

  @@schema("tracking")
  @@map("generated_programs")
}

/// One week's training-day swap, applied in createdAt order on top of the plan's week.
model ScheduleSwap {
  id        String   @id @default(uuid())
  programId String
  /// Monday of the week the swap applies to.
  weekStart DateTime @db.Date
  dayA      Int      @db.SmallInt
  dayB      Int      @db.SmallInt
  createdAt DateTime @default(now())

  program GeneratedProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, weekStart])
  @@schema("tracking")
  @@map("schedule_swaps")
}

model ActivityLog {
  id              String   @id @default(uuid())
  userId          String
  performedOn     DateTime @db.Date
  kind            String
  activityType    String
  durationMinutes Int
  distanceKm      Float?
  kcal            Int?
  kcalEstimated   Boolean  @default(true)
  avgHeartRate    Int?
  effort          String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, performedOn])
  @@schema("tracking")
  @@map("activity_logs")
}

model DietaryProfile {
  userId           String   @id
  dietPattern      String
  allergies        String[]
  dislikes         String   @default("")
  favouriteDishes  String[]
  mealPattern      String
  prepStyle        String?
  fasting          String   @default("NO")
  calorieAwareness String?
  proteinAwareness String?
  struggles        String[]
  updatedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("nutrition")
  @@map("dietary_profiles")
}

/// Custom-seeded local recipe layer (spec §9.4); generated from the engine catalogue.
model Recipe {
  id           String   @id @default(uuid())
  key          String   @unique
  dish         String
  name         String
  slot         String
  kcal         Int
  proteinG     Int
  carbsG       Int
  fatG         Int
  diets        String[]
  allergens    String[]
  portionGuide String
  isLocal      Boolean  @default(false)
  source       String   @default("custom-seeded")

  mealEntries MealEntry[]

  @@schema("nutrition")
  @@map("recipes")
}

model NutritionPlan {
  id          String   @id @default(uuid())
  userId      String
  cycleNumber Int      @default(1)
  dailyKcal   Int
  proteinG    Int
  carbsG      Int
  fatG        Int
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("nutrition")
  @@map("nutrition_plans")
}

/// A planned meal the user ticked as eaten and/or swapped. Untouched slots are computed.
model MealEntry {
  userId    String
  entryDate DateTime @db.Date
  slotIndex Int      @db.SmallInt
  recipeKey String?
  eaten     Boolean  @default(false)
  /// Replaced by a logged food (FoodLog.replacedSlotIndex); doesn't count as eaten.
  skipped   Boolean  @default(false)
  updatedAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeKey], references: [key], onDelete: SetNull)

  @@id([userId, entryDate, slotIndex])
  @@schema("nutrition")
  @@map("meal_entries")
}

/// A quick-add food the user saved ("My foods"). Name is unique per user, case-insensitive.
model CustomFood {
  id        String   @id @default(uuid())
  userId    String
  name      String
  kcal      Int
  proteinG  Int      @default(0)
  carbsG    Int      @default(0)
  fatG      Int      @default(0)
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs FoodLog[]

  @@schema("nutrition")
  @@map("custom_foods")
}

/// One food eaten. Name and numbers are copied from the food list (engine/foods.ts)
/// or a CustomFood at log time.
model FoodLog {
  id                String   @id @default(uuid())
  userId            String
  entryDate         DateTime @db.Date
  slot              String /// BREAKFAST | LUNCH | DINNER | SNACK
  foodKey           String?
  customFoodId      String?
  name              String
  portionLabel      String
  portionIndex      Int?     @db.SmallInt
  grams             Int?
  quantity          Float    @db.Real
  kcal              Int
  proteinG          Int      @default(0)
  carbsG            Int      @default(0)
  fatG              Int      @default(0)
  replacedSlotIndex Int?     @db.SmallInt
  createdAt         DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customFood CustomFood? @relation(fields: [customFoodId], references: [id], onDelete: SetNull)

  @@index([userId, entryDate])
  @@schema("nutrition")
  @@map("food_logs")
}

/// Water drunk on a day, in ml.
model WaterDay {
  userId    String
  entryDate DateTime @db.Date
  ml        Int
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, entryDate])
  @@schema("nutrition")
  @@map("water_days")
}

// ── Notifications ────────────────────────────────────────────────────────

/// One browser/device that allowed notifications (Web Push).
model PushSubscription {
  id         String    @id @default(uuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
  @@schema("notifications")
}

enum ReminderKind {
  TRAINING_DAY
  PLAN_START_EVE
  WEIGH_IN
  PROGRESS_PHOTO
  MISSED_SESSION
  CHECKIN_READY

  @@schema("notifications")
}

/// Each reminder goes out once per user, kind and local date.
model ReminderLog {
  userId    String
  kind      ReminderKind
  localDate DateTime     @db.Date
  sentAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, localDate])
  @@map("reminder_log")
  @@schema("notifications")
}

/// Switches for the optional reminders. No row means all on.
/// Progress-photo slots that hold a photo (files are in Firebase Storage).
model ProgressPhoto {
  userId  String
  /// Day 1 | Week 3 | Week 6
  slot    String
  savedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, slot])
  @@map("progress_photos")
  @@schema("tracking")
}

model ReminderPrefs {
  userId         String   @id
  weighIn        Boolean  @default(true)
  progressPhotos Boolean  @default(true)
  missedSession  Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_prefs")
  @@schema("notifications")
}

/// The week-6 check-in that closed a cycle and built the next.
model CycleCheckin {
  id            String   @id @default(uuid())
  userId        String
  programId     String   @unique
  nextProgramId String?
  answers       Json
  results       Json
  changes       Json
  createdAt     DateTime @default(now())

  program GeneratedProgram @relation("CheckinOf", fields: [programId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cycle_checkins")
  @@schema("tracking")
}
