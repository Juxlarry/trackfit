# Local/dev Postgres (swap for your Neon connection string in production)
DATABASE_URL="postgresql://trackfit:trackfit@localhost:5432/trackfit_dev"

# Firebase Admin SDK (service account JSON from your Firebase project)
# Download from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Set to "true" to bypass Firebase verification locally and auth as a fake dev user
# via the `x-dev-user-id` header. NEVER set this in production.
DEV_AUTH_BYPASS="true"

PORT=4000

# Transactional email (welcome email, club invites). "console" logs instead of
# sending; "resend" sends through Resend and needs the two values below.
MAIL_PROVIDER="console"
RESEND_API_KEY=""
# Sender, on a domain verified in Resend, e.g. "TrackFit <hello@mail.example.com>"
MAIL_FROM=""
# Optional: replies go here instead of to MAIL_FROM.
MAIL_REPLY_TO=""

# Club photos and videos. In production: the Firebase Storage bucket (same as
# the web app's VITE_FIREBASE_STORAGE_BUCKET); then run `npm run media:cors` once.
FIREBASE_STORAGE_BUCKET=""
# "local" keeps them in MEDIA_DIR and serves them from this API (the default
# when DEV_AUTH_BYPASS is on). PUBLIC_API_URL is this API's address for those links.
# MEDIA_STORE="local"
# MEDIA_DIR=""
# PUBLIC_API_URL="http://localhost:4000"

# Clubs: set to "false" to switch the whole feature off (emergency stop).
CLUBS_ENABLED="true"

# Public web app URL, used for links in emails.
APP_URL="http://localhost:5173"

# Web Push for workout reminders. Generate once: npx web-push generate-vapid-keys
# Leave empty to turn push off (the reminder sheet then says so).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services: mailto:you@example.com, or defaults to APP_URL.
VAPID_SUBJECT=""

# Bearer token an external cron sends to POST /jobs/reminders. Any long random string.
CRON_SECRET=""
